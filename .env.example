# Copia este archivo como .env y completa cada valor.
# Genera cada secreto con:  openssl rand -hex 32
# Nunca subas el .env al repo (ya esta en .gitignore).

# Vault (modo dev): token raiz, solo lo usa vault-init
VAULT_ROOT_TOKEN=
# Token de solo lectura que vault-init crea para el gateway
GATEWAY_VAULT_TOKEN=

# Secreto entre gateway e inventory
GATEWAY_INVENTORY_SECRET=
# Secreto entre gateway y auth (introspeccion de tokens)
AUTH_INTROSPECTION_SECRET=
# Secreto entre gateway y orders
GATEWAY_ORDERS_SECRET=
# Secreto entre orders e inventory (reservar y devolver stock)
ORDERS_INVENTORY_SECRET=
# Secreto entre gateway y payments
GATEWAY_PAYMENTS_SECRET=
# Secreto entre payments y orders (consultar pedido y marcarlo pagado)
PAYMENTS_ORDERS_SECRET=
# Secreto del proveedor de pagos (lo usa para autenticar el aviso S17)
PAYMENT_PROVIDER_SECRET=
# Secreto entre gateway y graphql-gateway
GATEWAY_GRAPHQL_SECRET=
# Secretos de solo lectura de graphql-gateway hacia orders e inventory
GRAPHQL_ORDERS_SECRET=
GRAPHQL_INVENTORY_SECRET=

# Usuario administrador de MongoDB
MONGO_ROOT_USER=chocomania
MONGO_ROOT_PASSWORD=

# Opcionales (tienen valor por defecto)
# Duracion de la sesion en segundos (900 = 15 min; usar 60 para probar sesion expirada)
# AUTH_TOKEN_TTL=900
# Fallas controladas para pruebas (plan 2.5), en milisegundos
# INVENTORY_FAULT_DELAY_MS=0
# ORDERS_FAULT_DELAY_MS=0
# Plazo maximo de respuesta entre servicios, en segundos
# UPSTREAM_TIMEOUT_SECONDS=5
# Plazo de orders hacia inventory (debe ser menor que el del gateway)
# ORDERS_UPSTREAM_TIMEOUT_SECONDS=3
# Proveedor de pagos simulado: inmediato | aviso, y APROBADO | RECHAZADO
# SIMULADOR_MODO=inmediato
# SIMULADOR_RESULTADO=APROBADO
# Cada cuantos segundos payments reintenta avisar a orders los pagos aprobados pendientes
# RECONCILIAR_CADA_SEGUNDOS=15
# Profundidad maxima de una consulta GraphQL
# GRAPHQL_MAX_DEPTH=6
