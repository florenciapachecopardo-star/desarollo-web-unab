<mxfile host="app.diagrams.net"><diagram name="M5 UML del API Gateway" id="m5"><mxGraphModel dx="1300" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1300" pageHeight="950" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="gw" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;ApiGateway&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;app: FastAPI (servicio gateway)&lt;br&gt;rutas: list[RouteDefinition]&lt;br&gt;servicios: dict[str, ServiceTarget]&lt;hr&gt;+registrar(ruta)&lt;br&gt;+reenviar(request, ruta, identidad)&lt;br&gt;+login() S06&lt;br&gt;+logout() S07&lt;br&gt;+me() S08" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFFFFF;strokeColor=#6B4226;" vertex="1" parent="1"><mxGeometry x="380" y="390" width="280" height="190" as="geometry"/></mxCell><mxCell id="rd" value="&lt;div style=&quot;text-align:center&quot;&gt;&amp;laquo;dataclass&amp;raquo;&lt;br&gt;&lt;b&gt;RouteDefinition&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;id: str (S01..S19)&lt;br&gt;method: str&lt;br&gt;path: str (ruta externa)&lt;br&gt;acceso: anonimo | autenticado | rol&lt;br&gt;roles: tuple&lt;br&gt;destino: str&lt;br&gt;ruta_interna: str" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#F5EDE6;strokeColor=#6B4226;" vertex="1" parent="1"><mxGeometry x="20" y="390" width="250" height="190" as="geometry"/></mxCell><mxCell id="st" value="&lt;div style=&quot;text-align:center&quot;&gt;&amp;laquo;dataclass&amp;raquo;&lt;br&gt;&lt;b&gt;ServiceTarget&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;url: str&lt;br&gt;secreto: str (clave en secret/gateway)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#F5EDE6;strokeColor=#6B4226;" vertex="1" parent="1"><mxGeometry x="20" y="650" width="250" height="90" as="geometry"/></mxCell><mxCell id="authn" value="&lt;div style=&quot;text-align:center&quot;&gt;&amp;laquo;política (función)&amp;raquo;&lt;br&gt;&lt;b&gt;AuthenticationPolicy&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;cookie: session_token&lt;hr&gt;+obtener_identidad(request): Identidad&lt;br&gt;+llamar_auth(ruta, body, con_secreto)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#F5EDE6;strokeColor=#6B4226;" vertex="1" parent="1"><mxGeometry x="380" y="190" width="280" height="120" as="geometry"/></mxCell><mxCell id="authz" value="&lt;div style=&quot;text-align:center&quot;&gt;&amp;laquo;política (función)&amp;raquo;&lt;br&gt;&lt;b&gt;AuthorizationPolicy&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;regla: acceso y roles de la ruta&lt;hr&gt;+permitir(ruta, identidad): bool&lt;br&gt;401 sin sesión / 403 sin rol" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#F5EDE6;strokeColor=#6B4226;" vertex="1" parent="1"><mxGeometry x="720" y="190" width="260" height="120" as="geometry"/></mxCell><mxCell id="sp" value="&lt;div style=&quot;text-align:center&quot;&gt;&amp;laquo;función con caché&amp;raquo;&lt;br&gt;&lt;b&gt;SecretProvider&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;vault_addr: str&lt;br&gt;vault_token: solo lectura&lt;br&gt;cache_segundos: 60&lt;hr&gt;+secretos(request): dict&lt;br&gt;503 si Vault no responde" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#F5EDE6;strokeColor=#6B4226;" vertex="1" parent="1"><mxGeometry x="720" y="390" width="260" height="150" as="geometry"/></mxCell><mxCell id="obs" value="&lt;div style=&quot;text-align:center&quot;&gt;&amp;laquo;middleware&amp;raquo;&lt;br&gt;&lt;b&gt;Observabilidad&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;header: X-Request-ID&lt;br&gt;logs: JSON&lt;hr&gt;+instalar(app, service, confiar_identidad)&lt;br&gt;+log(...)&lt;br&gt;+respuesta_error(...)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#F5EDE6;strokeColor=#6B4226;" vertex="1" parent="1"><mxGeometry x="380" y="650" width="280" height="130" as="geometry"/></mxCell><mxCell id="auth" value="&lt;div style=&quot;text-align:center&quot;&gt;&amp;laquo;service&amp;raquo;&lt;br&gt;&lt;b&gt;auth&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;/login&lt;br&gt;/introspect&lt;br&gt;/logout" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#F5EDE6;strokeColor=#6B4226;" vertex="1" parent="1"><mxGeometry x="380" y="20" width="180" height="100" as="geometry"/></mxCell><mxCell id="vault" value="&lt;div style=&quot;text-align:center&quot;&gt;&amp;laquo;sistema externo&amp;raquo;&lt;br&gt;&lt;b&gt;Vault&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;secret/gateway&lt;br&gt;política gateway: read" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#F5EDE6;strokeColor=#6B4226;" vertex="1" parent="1"><mxGeometry x="1040" y="390" width="190" height="90" as="geometry"/></mxCell><mxCell id="svc" value="&lt;div style=&quot;text-align:center&quot;&gt;&amp;laquo;service&amp;raquo;&lt;br&gt;&lt;b&gt;Servicio destino&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;inventory, orders, payments&lt;br&gt;exige X-Gateway-Secret propio" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#F5EDE6;strokeColor=#6B4226;" vertex="1" parent="1"><mxGeometry x="20" y="810" width="250" height="80" as="geometry"/></mxCell><mxCell id="gql" value="&lt;div style=&quot;text-align:center&quot;&gt;&amp;laquo;pendiente PR F&amp;raquo;&lt;br&gt;&lt;b&gt;GraphQLGateway&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;privado: solo desde el gateway&lt;hr&gt;+ejecutar(query)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFFFFF;strokeColor=#6B4226;dashed=1;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="720" y="650" width="240" height="100" as="geometry"/></mxCell><mxCell id="schema" value="&lt;div style=&quot;text-align:center&quot;&gt;&amp;laquo;pendiente PR F&amp;raquo;&lt;br&gt;&lt;b&gt;Schema&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;Query misPedidos&lt;br&gt;límite de profundidad" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFFFFF;strokeColor=#6B4226;dashed=1;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="1040" y="650" width="190" height="90" as="geometry"/></mxCell><mxCell id="res" value="&lt;div style=&quot;text-align:center&quot;&gt;&amp;laquo;pendiente PR F&amp;raquo;&lt;br&gt;&lt;b&gt;Resolver&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;misPedidos: orders + inventory" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#FFFFFF;strokeColor=#6B4226;dashed=1;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="1040" y="810" width="190" height="80" as="geometry"/></mxCell><mxCell id="e1" value="" style="endArrow=none;startArrow=diamondThin;startFill=1;startSize=14;html=1;strokeColor=#3B1F1A;" edge="1" parent="1" source="gw" target="rd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1s" value="1" style="edgeLabel;html=1;resizable=0;fontStyle=1;" vertex="1" connectable="0" parent="e1"><mxGeometry x="-0.8" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e1t" value="1..*" style="edgeLabel;html=1;resizable=0;fontStyle=1;" vertex="1" connectable="0" parent="e1"><mxGeometry x="0.8" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e2" value="destino" style="endArrow=none;html=1;strokeColor=#3B1F1A;" edge="1" parent="1" source="rd" target="st"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2s" value="0..*" style="edgeLabel;html=1;resizable=0;fontStyle=1;" vertex="1" connectable="0" parent="e2"><mxGeometry x="-0.8" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e2t" value="1" style="edgeLabel;html=1;resizable=0;fontStyle=1;" vertex="1" connectable="0" parent="e2"><mxGeometry x="0.8" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e3" value="usa" style="endArrow=open;dashed=1;html=1;strokeColor=#A9784D;" edge="1" parent="1" source="gw" target="authn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="usa" style="endArrow=open;dashed=1;html=1;strokeColor=#A9784D;" edge="1" parent="1" source="gw" target="authz"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="usa" style="endArrow=open;dashed=1;html=1;strokeColor=#A9784D;" edge="1" parent="1" source="gw" target="sp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="usa" style="endArrow=open;dashed=1;html=1;strokeColor=#A9784D;" edge="1" parent="1" source="gw" target="obs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="/introspect" style="endArrow=open;dashed=1;html=1;strokeColor=#A9784D;" edge="1" parent="1" source="authn" target="auth"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="lee" style="endArrow=open;dashed=1;html=1;strokeColor=#A9784D;" edge="1" parent="1" source="sp" target="vault"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="reenvía" style="endArrow=open;dashed=1;html=1;strokeColor=#A9784D;" edge="1" parent="1" source="st" target="svc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="S18" style="endArrow=open;dashed=1;html=1;strokeColor=#A9784D;" edge="1" parent="1" source="gw" target="gql"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="endArrow=none;html=1;strokeColor=#3B1F1A;" edge="1" parent="1" source="gql" target="schema"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11s" value="1" style="edgeLabel;html=1;resizable=0;fontStyle=1;" vertex="1" connectable="0" parent="e11"><mxGeometry x="-0.8" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e11t" value="1" style="edgeLabel;html=1;resizable=0;fontStyle=1;" vertex="1" connectable="0" parent="e11"><mxGeometry x="0.8" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e12" value="" style="endArrow=none;startArrow=diamondThin;startFill=1;startSize=14;html=1;strokeColor=#3B1F1A;" edge="1" parent="1" source="schema" target="res"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12s" value="1" style="edgeLabel;html=1;resizable=0;fontStyle=1;" vertex="1" connectable="0" parent="e12"><mxGeometry x="-0.8" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e12t" value="1..*" style="edgeLabel;html=1;resizable=0;fontStyle=1;" vertex="1" connectable="0" parent="e12"><mxGeometry x="0.8" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="nota" value="&lt;b&gt;Nota:&lt;/b&gt; en el código, AuthenticationPolicy, AuthorizationPolicy y SecretProvider son funciones de backend/gateway/gateway.py (obtener_identidad, el handler de registrar y secretos). Observabilidad está en backend/gateway/observabilidad.py. Las clases punteadas llegan con el PR F." style="shape=note;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FFF8E7;strokeColor=#A9784D;" vertex="1" parent="1"><mxGeometry x="620" y="20" width="420" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>